# ----------------------------------------------------------------------
# AgroDoc backend configuration
# ----------------------------------------------------------------------
# Copy this file to ".env" and edit the values you need.
#   cp .env.example .env
# Never commit your real .env file (it is gitignored).
# ----------------------------------------------------------------------

# ---- General ----
ENVIRONMENT=development
DEBUG=true

# ---- Database ----
# SQLite (file) for local development — no install needed.
DATABASE_URL=sqlite:///./agrodoc.db
# For production use PostgreSQL + PostGIS (via Docker):
# DATABASE_URL=postgresql+psycopg2://agrodoc:change-me@localhost:5432/agrodoc

# ---- Security ----
# IMPORTANT: change this to a long random string in production.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-please-9f2c7e1a4b8d3a6f0e5b2c7d8a1f4e3b
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- File uploads ----
UPLOAD_DIR=uploads
MAX_IMAGE_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true

# ---- AI Crop Doctor ----
# none  = diagnosis reported as unavailable (default, safe).
# openai = use an OpenAI-compatible vision API (needs OPENAI_API_KEY).
# local  = use a self-hosted model file (needs LOCAL_MODEL_PATH + runtime).
AI_PROVIDER=none

# Used when AI_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini

# Used when AI_PROVIDER=local:
LOCAL_MODEL_PATH=

# ---- Weather ----
# open-meteo is free and needs no key. "none" disables the weather module.
WEATHER_PROVIDER=open-meteo
